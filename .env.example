# Copy to .env (git-ignored) and add the key(s) for the providers you use. Never commit real keys.
# The planner uses the provider chosen in Settings (NVIDIA NIM by default).

# NVIDIA NIM (default). Comma list, or NVIDIA_NIM_API_KEY_1 .. _9.
NVIDIA_NIM_API_KEYS=

# Claude (single key)
ANTHROPIC_API_KEY=

# ChatGPT (single key)
OPENAI_API_KEY=

# Gemini (single or multi-key): GOOGLE_API_KEY, or GOOGLE_API_KEY_1 .. _9
GOOGLE_API_KEY=

# Grok (single key)
XAI_API_KEY=

# Matilda (single or multi-key): MATILDA_API_KEY, or MATILDA_API_KEY_1 .. _9.
# Matilda also needs its endpoint and model list before it can plan:
MATILDA_API_KEY=
MATILDA_BASE_URL=
# PROPHET_MATILDA_MODELS=model-one,model-two

# Optional: override any provider's model chain (comma list, tried in order). Example:
# PROPHET_OPENAI_MODELS=gpt-5,gpt-5-mini
