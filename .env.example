# Copy to .env (git-ignored) and add the key(s) for the providers you use. Never commit real keys.
# The planner uses the provider chosen in Settings (NIM by default).

# NIM (default). Comma list, or NVIDIA_NIM_API_KEY_1 .. _9.
NVIDIA_NIM_API_KEYS=

# Claude (single key)
ANTHROPIC_API_KEY=

# ChatGPT (single key)
OPENAI_API_KEY=

# Gemini (Google AI Studio; single or multi-key): GOOGLE_API_KEY, or GOOGLE_API_KEY_1 .. _9
GOOGLE_API_KEY=

# Grok (single key)
XAI_API_KEY=

# Matilda (single or multi-key): MATILDA_API_KEY, or MATILDA_API_KEY_1 .. _9.
# Matilda's endpoint defaults to https://matilda.maincode.com/api/v1; set MATILDA_BASE_URL only to override it.
MATILDA_API_KEY=
MATILDA_BASE_URL=

# FreeRouter (single key, sk-fr-...). The endpoint defaults to https://free-router-olive.vercel.app/v1; set FREEROUTE_BASE_URL only to override it.
FREEROUTE_API_KEY=
FREEROUTE_BASE_URL=

# Models are fixed by the catalog in src/prophet_agent/nim/providers.py. Switch providers and models on or off in Settings.
